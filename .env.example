# FaceAttend local desktop configuration.
# Copy this file to .env. The .env file is ignored by Git.

# ML
EMBEDDING_MODEL_PATH=./ml/models/arcface_r100.onnx
EMBEDDING_MODEL_VERSION=arcface-r100-v1
LIVENESS_MODEL_PATH=./ml/models/MiniFASNetV2.onnx
ACTIVE_LIVENESS_MODEL_PATH=./ml/models/mediapipe/face_landmarker_v2_with_blendshapes.task

# Webcam device index. Most computers use 0; the current development machine uses 1.
FACEATTEND_CAMERA_INDEX=0

# Optional paths. Leave these commented to use the repository defaults.
# FACEATTEND_DATABASE_PATH=./data/faceattend.sqlite3
# FACEATTEND_MODEL_DIR=./models

# Provisional local prototype thresholds. They are not production-calibrated.
FACEATTEND_PASSIVE_THRESHOLD=0.85
FACEATTEND_MATCH_THRESHOLD=0.75
FACEATTEND_AMBIGUITY_MARGIN=0.05
