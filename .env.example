# Shared
ENV=development
LOG_LEVEL=info

# Local desktop application (copy this file to .env; .env is ignored by Git)
# The current developer machine uses 1. Use 0 or another index on your machine.
FACEATTEND_CAMERA_INDEX=1
# FACEATTEND_DATABASE_PATH=./data/faceattend.sqlite3
# FACEATTEND_MODEL_DIR=./models

# Database
POSTGRES_URI=postgresql+asyncpg://user:pass@localhost:5432/faceattend
ALEMBIC_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/faceattend
REDIS_URI=redis://localhost:6379

# Vector DB
VECTOR_DB_BACKEND=faiss
VECTOR_DB_URI=
VECTOR_DB_INDEX_PATH=./data/faiss.idx

# Queue
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET_IMAGES=faceattend-images
S3_BUCKET_EXPORTS=faceattend-exports

# Auth
JWT_SECRET=changeme-use-32-plus-random-bytes-in-production
JWT_ISSUER=faceattend
API_KEY_SECRET=changeme

# Service URLs
BACKEND_API_URL=http://localhost:8002
ML_SERVICE_URL=http://localhost:8003

# ML
EMBEDDING_MODEL_PATH=./models/arcface_r100.onnx
EMBEDDING_MODEL_VERSION=arcface-r100-v1
LIVENESS_MODEL_PATH=./models/minifasnet_v2.onnx
LIVENESS_THRESHOLD_PASSIVE=0.85
LIVENESS_THRESHOLD_ACTIVE=0.95
PASSIVE_FRAME_SAMPLE_COUNT=10
PASSIVE_LIVENESS_PASS_RATIO=0.8
FACE_VISIBLE_RATIO=0.8
ATTENDANCE_MATCH_THRESHOLD=0.75
CHECK_IN_EMBEDDING_FRAME_COUNT=3

# Notifications
EMAIL_PROVIDER=postmark
EMAIL_API_KEY=changeme
EMAIL_FROM=alerts@faceattend.io

# Billing
STRIPE_SECRET_KEY=changeme
STRIPE_WEBHOOK_SECRET=changeme

# Compliance
DATA_RETENTION_DAYS=30
GDPR_DELETE_GRACE_HOURS=24
